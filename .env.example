# Required
DATABASE_URL="postgresql://user:password@localhost:5432/projectflow"
JWT_SECRET="replace-with-a-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-with-another-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
# Where the web app runs (CORS + OAuth redirect)
FRONTEND_URL="http://localhost:3000"

# Google OAuth (any non-empty value boots the API; real values enable "Continue with Google")
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Optional: transactional email via Resend. Without it emails are logged instead of sent.
RESEND_API_KEY=""
# Base URL used in email links
APP_URL="http://localhost:3000"
